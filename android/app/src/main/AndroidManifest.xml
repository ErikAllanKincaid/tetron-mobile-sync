<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SYNC-002: rsync client network I/O (the embedded engine opens its
         own sockets; a socket call with no INTERNET grant fails silently
         as a connect refusal, not a permission error). SYNC-004/006:
         ConnectivityManager reads for the Wi-Fi gate
         (AndroidDeviceStateProvider) and the network-change trigger
         (AndroidNetworkChangeTrigger). Correction 2026-08-19: this
         SYNC-001 comment previously said these "arrive with" SYNC-002/004,
         but neither of those requirements actually added them; caught only
         now that SYNC-006 wires a manifest-registered NetworkCallback and
         a WorkManager job with a CONNECTED constraint, the first real
         callers. READ_MEDIA_* still arrives with SYNC-008. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SYNC-008: camera-roll read access. API 33+ ("Tiramisu") replaced
         READ_EXTERNAL_STORAGE with the scoped media permissions below for
         this purpose; READ_EXTERNAL_STORAGE is kept maxSdkVersion-capped
         for the API 26..32 range v1's minSdk still covers.
         READ_MEDIA_VISUAL_USER_SELECTED (API 34+, "select photos") is the
         partial-grant path AndroidMediaAccess/resolveMediaAccessGrant
         detects to show the warning banner; requesting it is what lets the
         OS offer that choice at all, per Android's own permission dialog
         behavior. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- SYNC-009: gate-blocked and completion/failure notifications
         (xyz.tetron.sync.notifications.SyncNotifier). API 33+ requires
         this as a runtime-requested dangerous permission, same as the
         media permissions above; MainActivity requests it eagerly at
         first launch rather than tied to a specific button, since (unlike
         photo access) there is no single natural action in this app's
         flow to hang the request on and a background-triggered run has no
         UI moment at all to request it from. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- SYNC-003: package-visibility declaration for the MOBILE-024 bridge.
         ContentResolver.call() itself reaches any exported provider without
         this; it only makes PackageManager.resolveContentProvider() (used
         by the device test's skip-if-absent check) deterministic on
         Android 11+. -->
    <queries>
        <provider android:authorities="xyz.tetron.mobile.status" />
    </queries>

    <application
        android:name=".TetronSyncApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.TetronSync">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SYNC-009: WorkManager's default androidx-startup initializer
             uses its own reflective WorkerFactory, which can not carry
             SyncWorkerFactory's PipelineRunner dependency into SyncWorker.
             Removing it here is what makes TetronSyncApplication's own
             Configuration.Provider (WorkManager.getInstance() lazily
             on-demand-initializes from that instead) the one that wins. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>